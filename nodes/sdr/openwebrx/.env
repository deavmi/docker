#
# OpenWebRX configuration
#
OPENWEBRX_USERNAME=admin
OPENWEBRX_PASSWORD=admin

OPENWEBRX_STORAGE_ETC=/mnt/datadisk/volumes/openwebrx/etc
OPENWEBRX_STORAGE_VAR=/mnt/datadisk/volumes/openwebrx/var
OPENWEBRX_STORAGE_PLUGINS=/mnt/datadisk/volumes/openwebrx/plugins

OPENWEBRX_DEVICE_1=/dev/swradio0

#
# Addressing
#
OPENWEBRX_IPV6_ADDR=${IPV6_NODE1_ADDR}
OPENWEBRX_YGG_ADDR=${YGG_NODE1_ADDR}
OPENWEBRX_DOMAIN_1=openwebrx.radio.deavmi.assigned.network
OPENWEBRX_DOMAIN_2=openwebrx.radio.deavmi.org
OPENWEBRX_DOMAIN_3=openwebrx.radio.deavmi.com
