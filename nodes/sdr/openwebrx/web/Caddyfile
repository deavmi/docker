
{
	http_port "80"
	https_port "443"

	log default {
			output stdout
			level INFO
	}

	# Don't tell HTTP clients to upgrade to HTTPS
	auto_https disable_redirects

  metrics {
	 	per_host
  }
}


# Domain name for automatic SSL
:80, {$DOMAIN}:443, {$DOMAIN_1}:443, {$DOMAIN_2}:443 {

	# Handle metrics
	handle /metrics {
	    metrics
	}

	# OpenWebRX
	handle /sdr* {
		uri strip_prefix /sdr
		reverse_proxy openwebrc:8073
	}
}
