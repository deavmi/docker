{
	http_port "80"

	log default {
			output stdout
			level {$DEBUG_LEVEL}
	}

  # Don't tell HTTP clients to upgrade to HTTPS
  auto_https disable_redirects
}


# Domain name for automatic SSL
:80 {
	# Handle metrics
	handle /caddymetrics {
	    metrics
	}
	
	# Reverse proxy to
	handle /* {
		reverse_proxy {$WHERE_TO_ADDR}:{$WHERE_TO_PORT}/projects/bonobonet
	}
}
