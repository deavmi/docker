# IP addressing
PARTYLINE_RETICULUM_IPV6_ADDR=${IPV6_NODE1_ADDR}
PARTYLINE_RETICULUM_YGG_ADDR=${YGG_NODE1_ADDR}


# Partyline's our state directory and its own reticulum
# router instance's state directory
PARTYLINE_STATE_DIR=/mnt/datadisk/volumes/partyline/state
PARTYLINE_RET_DIR=/mnt/datadisk/volumes/partyline/rstate
PARTYLINE_ANNOUNCE_INTERVAL=60
PARTYLINE_STATS_INTERVAL=60

# Sister reticulum instance's sttae directory
PARTYLINE_RETICULUM_RET_DIR=/mnt/datadisk/volumes/reticulum
