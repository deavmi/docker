# Copyparty configuration directory (holds user and password)
COPYPARTY_CFG_DIR=/mnt/datadisk/volumes/copyparty/cfg

# Copyparty media directory (holds media)
COPYPARTY_MEDIA_DIR=/mnt/datadisk/volumes/copyparty/media

# Networking
COPYPARTY_IPV6_ADDR=${IPV6_NODE1_ADDR}
COPYPARTY_YGG_ADDR=${YGG_NODE1_ADDR}
COPYPARTY_DOMAIN_1=copyparty.media.deavmi.org
COPYPARTY_DOMAIN_2=copyparty.media.deavmi.com
