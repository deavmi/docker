
# Domain
DOMAIN=small.personal.deavmi.assigned.network

# Yggdrasil IPv6 subnet for containers that
# use it
YGG_POOL_SUBNET=300:487d:c95:52ad::/64
YGG_NODE1_ADDR=300:487d:c95:52ad::1
YGG_NODE2_ADDR=300:487d:c95:52ad::2
YGG_NODE3_ADDR=300:487d:c95:52ad::3
YGG_NODE4_ADDR=300:487d:c95:52ad::4

# IPv6 subnet for containers that use it
IPV6_POOL_SUBNET=2a04:5b81:2010:401a::/64
IPV6_NODE1_ADDR=""
IPV6_NODE2_ADDR=2a04:5b81:2010:401a::2
IPV6_NODE3_ADDR=2a04:5b81:2010:401a::3
IPV6_NODE4_ADDR=2a04:5b81:2010:401a::4



# Global settings (for builds)
USER_UID=1000
USER_GID=1000

# Set the configuration file path for Yggdrasil
YGGDRASIL_CONF_PATH=/mnt/datadisk/volumes/yggdrasil/yggdrasil.conf

# Set the data directory for Mycelium
MYCELIUM_DATA_DIR=/mnt/datadisk/volumes/mycelium/
MYCELIUM_LOG_OPTION=silent
MYCELIUM_PEERS_STRING="tcp://[2a01:4ff:2f0:3621::1]:9651 tcp://[2604:a00:50:17b:9e6b:ff:fe1f:e054]:9651"


# Ntfy.sh
NTFY_PORT=8081
NTFY_ETC_PATH=/mnt/datadsk/volumes/ntfy/etc
NTFY_DATA_PATH=/mnt/datadisk/volumes/ntfy/data
NTFY_AUTH_PATH=/mnt/datadisk/volumes/ntfy/auth


# Cryptpad
CRYPTPAD_STORE_BLOB=/mnt/datadisk/volumes/cryptpad/blobs
CRYPTPAD_STORE_BLOCK=/mnt/datadisk/volumes/cryptpad/blocks
CRYPTPAD_STORE_DATA=/mnt/datadisk/volumes/cryptpad/data
CRYPTPAD_STORE_FILES=/mnt/datadisk/volumes/cryptpad/datastore
CRYPTPAD_STORE_CONFIG=/mnt/datadisk/volumes/cryptpad/config/
CRYPTPAD_DOMAIN=docs.smallnode.deavmi.assigned.network
CRYPTPAD_IPV6_ADDR=${IPV6_NODE3_ADDR}
CRYPTPAD_YGG_ADDR=${YGG_NODE3_ADDR}