# YggMail auto
YGGMAIL_PEER=tls://yggdrasil.deavmi.assigned.network:2001
YGGMAIL_STORAGE=/mnt/datadisk/volumes/yggmail/data
YGGMAIL_PASSWORD_HASH_FILE_PATH=/mnt/datadisk/volumes/yggmail/pwhash.secret

# Used for TLS endpoint for yggmail_tls
IPV6_ADDR_TLS_YGGMAIL=${IPV6_NODE2_ADDR}

# Endpoint used for Yggdrasil access TO the Yggmail
# server
YGG_ADDR_YGGMAIL=${YGG_NODE2_ADDR}
YGGMAIL_TLS_CACHE_DIR=/mnt/datadisk/volumes/yggmail/tls/cache

# Used for (RoundCube UI + Caddy)
YGGMAIL_UI_DOMAIN_IMAP=imap.yggmail.deavmi.assigned.network
YGGMAIL_UI_DOMAIN_SMTP=smtp.yggmail.deavmi.assigned.network
YGGMAIL_UI_DOMAIN=web.yggmail.deavmi.assigned.network
YGGMAIL_UI_DOMAIN_1=web.yggmail.deavmi.org
YGGMAIL_UI_DOMAIN_2=web.yggmail.deavmi.com
YGGMAIL_UI_TEMP_PATH=/mnt/datadisk/volumes/yggmail/ui/temp
YGGMAIL_UI_DB_PATH=/mnt/datadisk/volumes/yggmail/ui/db
YGGMAIL_UI_YGG=${YGG_NODE3_ADDR}
YGGMAIL_UI_IPV6=${IPV6_NODE3_ADDR}
