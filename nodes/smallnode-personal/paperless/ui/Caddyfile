{
	http_port "80"
	https_port "443"

	log default {
			output stdout
			level {$DEBUG_LEVEL}
	}

  # Don't tell HTTP clients to upgrade to HTTPS
  # auto_https disable_redirects
}


# Domain name for automatic SSL
:80, {$DOMAIN}:443, {$DOMAIN_1}:443, {$DOMAIN_2}:443 {
	# Handle metrics
	handle /caddymetrics {
	    metrics
	}

	@login path /accounts/login/ 
	reverse_proxy @login {$WHERE_TO_ADDR}:{$WHERE_TO_PORT} {
		header_down Referrer-Policy "same-origin"
	}
	
	# Reverse proxy to
	reverse_proxy {$WHERE_TO_ADDR}:{$WHERE_TO_PORT} /* {
		header_down Referrer-Policy "no-referrer"		
	}
}
